# Copy to .env and fill in credentials. Never commit populated .env files.
# Required for the current application setup.
OPENAI_API_KEY=

# Optional providers: uncomment and fill in the credentials you use.
# TAVILY_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Alternative to GEMINI_API_KEY.
# SERPER_API_KEY=
# KAGGLE_API_TOKEN=
# GITHUB_TOKEN=
# OPENALEX_API_KEY=
# ANTHROPIC_API_KEY=  # Enables the final reviewer.

# Optional model overrides; otherwise the application defaults apply.
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_MODEL=claude-haiku-5-5

SAVE_RUNS=true
LOG_LEVEL=INFO
# RUNS_DIR=runs
